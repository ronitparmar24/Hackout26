# MongoDB Atlas Connection Configuration Template
# Set your actual credentials in backend/.env (which is gitignored)
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority&appName=CarbonSense
MONGODB_DB_NAME=carbonsense

# LLM Configuration (OpenAI, Gemini, Groq, or OpenAI-compatible provider)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
